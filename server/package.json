{
  "name": "stylehaven-server",
  "version": "2.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed/seed.js",
    "export:db": "node src/scripts/exportDatabase.js",
    "test": "node --test src/**/*.test.js",
    "check": "node src/scripts/checkSyntax.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "connect-mongo": "5.1.0",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "express-session": "1.18.1",
    "helmet": "8.1.0",
    "mongoose": "8.15.1",
    "morgan": "1.10.0"
  }
}
