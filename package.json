{
  "name": "stylehaven-d2-complete",
  "version": "2.0.0",
  "private": true,
  "description": "CMP7246 Deliverable 2 MERN server-side project for StyleHaven online clothing store.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace client",
    "seed": "npm run seed --workspace server",
    "export:db": "npm run export:db --workspace server",
    "test": "npm run test --workspace server",
    "check": "npm run check --workspace server",
    "validate:data": "node server/src/scripts/validateSubmission.js",
    "preflight": "npm run check && npm run test && npm run validate:data"
  },
  "engines": {
    "node": ">=20"
  }
}
